@* A person's (teacher's or room's) week, one row per day with lessons in time order. *@
<MudPaper Class="pa-3">
    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.h6">@Title: @Timetable.Name</MudText>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small">@Timetable.PeriodsPerWeek periods a week</MudChip>
    </div>
    @foreach (var day in Timetable.Days)
    {
        var items = Timetable.Slots.Where(s => s.Day == day).OrderBy(s => s.StartTime).ToList();
        <div class="tt-week-row">
            <div class="tt-week-day">@day<small>@items.Count</small></div>
            <div class="tt-week-items">
                @if (items.Count == 0)
                {
                    <span class="tt-free">Free</span>
                }
                @foreach (var s in items)
                {
                    <div class="tt-lesson wide" style="--c:@TimetablePage.Colour(s.SubjectCode)">
                        <small>@s.StartTime.ToString("HH:mm")–@s.EndTime.ToString("HH:mm")</small>
                        <b>@s.SubjectCode</b>
                        <span>@(ShowSection ? s.SectionLabel : TimetablePage.Initials(s.TeacherName))@(s.RoomName is null ? "" : " · " + s.RoomName)</span>
                    </div>
                }
            </div>
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public PersonTimetable Timetable { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool ShowSection { get; set; }
}
