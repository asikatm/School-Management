@inject IJSRuntime JS

@* Shows a generated password once; the API never returns it again. *@
<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Give this temporary password to <b>@UserName</b> now. It will not be shown again; they must change it at first sign-in.
        </MudAlert>
        <div class="d-flex align-center gap-2">
            <MudTextField Value="Password" ReadOnly="true" Variant="Variant.Outlined" Label="Temporary password"
                          Style="font-family:monospace;font-size:1.3rem" />
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" title="Copy" OnClick="Copy" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string Password { get; set; } = "";

    private async Task Copy()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password); }
        catch (JSException) { /* clipboard not available (e.g. plain http); the user can still select the text */ }
    }
}
