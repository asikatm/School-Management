@page "/change-password"
@inherits AppPage

<PageTitle>Change password</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Change password</MudText>

@if (Session.MustChangePassword)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">You are using a temporary password. Choose a new one to continue.</MudAlert>
}

<MudPaper Class="pa-6" Style="max-width:520px">
    <MudTextField @bind-Value="current" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4"
                  Error="HasError(nameof(ChangePasswordRequest.CurrentPassword))" ErrorText="@ErrorFor(nameof(ChangePasswordRequest.CurrentPassword))" />
    <MudTextField @bind-Value="next" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4"
                  HelperText="At least 8 characters." Immediate="true"
                  Error="HasError(nameof(ChangePasswordRequest.NewPassword))" ErrorText="@ErrorFor(nameof(ChangePasswordRequest.NewPassword))" />
    <MudTextField @bind-Value="confirm" Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4"
                  Immediate="true" Error="@(confirm.Length > 0 && confirm != next)" ErrorText="Passwords do not match." />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
               Disabled="@(Busy || current.Length == 0 || next.Length < 8 || next != confirm)">Change password</MudButton>
</MudPaper>

@code {
    private string current = "";
    private string next = "";
    private string confirm = "";

    private async Task Save()
    {
        var userName = Session.Me!.User.UserName;
        if (await Run(() => Api.PostAsync("api/auth/change-password", new ChangePasswordRequest(current, next)), "Password changed."))
        {
            // The API revoked all sessions; sign in again with the new password.
            await Session.SignInAgainAsync(userName, next);
            Nav.NavigateTo(Session.IsSignedIn ? "" : "login", replace: true);
        }
    }
}
