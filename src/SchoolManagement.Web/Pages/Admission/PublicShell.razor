@* Frame for the public (no-login) admission pages. *@

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <div class="d-flex align-center gap-3 mb-6">
        <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Style="font-size:2.75rem" />
        <div>
            <MudText Typo="Typo.h5">Lighthouse International School</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
        </div>
    </div>
    @ChildContent
</MudContainer>

@code {
    [Parameter] public string Subtitle { get; set; } = "Admissions";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
