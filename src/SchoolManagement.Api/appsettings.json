{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=SchoolManagement;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Jwt": {
    "Issuer": "school-management",
    "Audience": "school-management-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "RootPath": "../../storage",
    "MaxFileBytes": 10485760,
    "EnableDefenderScan": true
  },
  "Backup": {
    "Enabled": true,
    "Directory": "",
    "DailyHourLocal": 2,
    "RetentionDays": 30
  },
  "Notifications": {
    "Sms": {
      "ApiUrl": "",
      "ApiKey": "",
      "SenderId": ""
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "FromAddress": "no-reply@lighthouseschoolbd.com",
      "FromName": "Lighthouse International School"
    }
  },
  "PublicSite": {
    "BaseUrl": "https://lighthouseschoolbd.com"
  },
  "Cors": {
    "Origins": []
  },
  "Seed": {
    "AdminPassword": "",
    "AdminEmail": ""
  }
}
